{
  // The source folders by name, not "**/*.ts": TypeScript 7's watcher reacts
  // to any change under a folder it watches, and `npm run build` rewrites
  // build/ while a dev watcher may be running.
  "include": [
    "*.ts",
    "libs/**/*.ts",
    "models/**/*.ts",
    "socket/**/*.ts",
    "tests/**/*.ts"
  ],
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "./",

    // Node 22+ ESM: top-level await, import/export, .js specifiers
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // type checking
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
