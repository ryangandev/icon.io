{
    "name": "icon.io-back",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "rimraf build && tsc",
        "watch": "tsc-watch --onSuccess \"npm run start:dev\"",
        "start:dev": "cross-env NODE_ENV=development node build/server.js",
        "build:deploy": "npm run build && (cd ../front && npm run build)",
        "start:prod": "cross-env NODE_ENV=production node build/server.js",
        "start:deploy": "cross-env NODE_ENV=production pm2 start build/server.js --name icon-io",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^5.2.1",
        "socket.io": "^4.8.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.1",
        "cross-env": "^10.1.0",
        "rimraf": "^6.1.3",
        "tsc-watch": "^7.2.1",
        "typescript": "^7.0.2"
    }
}
