{
  "name": "zumpo-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsc-watch --noClear --onSuccess \"node build/server/server.js\"",
    "build": "rimraf --glob \"build/*\" && tsc -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=production node build/server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "socket.io-client": "^4.8.3",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
